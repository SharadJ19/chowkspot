# ==========================================
# Server Configuration
# ==========================================
# Port on which the backend server will run
PORT=5000

# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# Allowed CORS origin (URL of your frontend app)
CLIENT_ORIGIN=http://localhost:5173

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL Connection URL format:
# postgres://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://postgres:pgdev123@localhost:5432/chowkspot_db

# ==========================================
# Authentication & Security Secrets
# ==========================================
# Secrets used for signing JSON Web Tokens (JWT).
# IMPORTANT: Use random 32-byte string values in production!
# You can generate strong keys using Linux/Mac terminal:
#   openssl rand -hex 32
#
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_me_in_prod
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_me_in_prod
